# Образец локальной конфигурации секретов (BACKLOG B-4).
# Скопируйте в .env (файл игнорируется git) и заполните значения.
# Переменные окружения процесса имеют приоритет над .env.

# Пароль создаваемого администратора при первой инициализации БД
KANZLER_ADMIN_PASSWORD=

# Необязательный путь к файлу базы данных (по умолчанию data/kanzler_pro.db)
KANZLER_DB=
